{
  "name": "40k-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Warhammer 40,000 army list builder and step-by-step game companion (web + Android).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
